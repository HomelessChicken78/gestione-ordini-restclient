<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="PagamentoOrdine"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              uuid="c2b3a7d0-0000-0000-0000-000000000001">

    <!-- ===================== -->
    <!-- FIELDS -->
    <!-- ===================== -->
    <field name="id_ordine" class="java.lang.String"/>
    <field name="data_creazione" class="java.sql.Date"/>
    <field name="totale" class="java.lang.Double"/>
    <field name="descrizione" class="java.lang.String"/>
    <field name="stato_ordine" class="java.lang.String"/>
    <field name="username_cliente" class="java.lang.String"/>
    <field name="email_cliente" class="java.lang.String"/>
    <field name="nome_ricevuta" class="java.lang.String"/>

    <!-- ===================== -->
    <!-- TITLE -->
    <!-- ===================== -->
    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Ricevuta Pagamento Ordine]]></text>
            </staticText>
        </band>
    </title>

    <!-- ===================== -->
    <!-- DETAIL -->
    <!-- ===================== -->
    <detail>
        <band height="250">

            <!-- ID Ordine -->
            <textField>
                <reportElement x="0" y="10" width="300" height="20"/>
                <textFieldExpression><![CDATA["ID Ordine: " + $F{id_ordine}]]></textFieldExpression>
            </textField>

            <!-- Data -->
            <textField>
                <reportElement x="0" y="30" width="300" height="20"/>
                <textFieldExpression><![CDATA["Data creazione: " + $F{data_creazione}]]></textFieldExpression>
            </textField>

            <!-- Cliente -->
            <textField>
                <reportElement x="0" y="60" width="400" height="20"/>
                <textFieldExpression><![CDATA["Cliente: " + $F{username_cliente} + " (" + $F{email_cliente} + ")"]]></textFieldExpression>
            </textField>

            <!-- Nome ricevuta -->
            <textField>
                <reportElement x="0" y="80" width="400" height="20"/>
                <textFieldExpression><![CDATA["Intestazione ricevuta: " + $F{nome_ricevuta}]]></textFieldExpression>
            </textField>

            <!-- Descrizione -->
            <textField isStretchWithOverflow="true">
                <reportElement x="0" y="110" width="550" height="40"/>
                <textFieldExpression><![CDATA["Descrizione: " + $F{descrizione}]]></textFieldExpression>
            </textField>

            <!-- Stato ordine -->
            <textField>
                <reportElement x="0" y="160" width="300" height="20"/>
                <textFieldExpression><![CDATA["Stato: " + $F{stato_ordine}]]></textFieldExpression>
            </textField>

            <!-- Totale -->
            <textField>
                <reportElement x="0" y="190" width="300" height="30"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Totale: € " + $F{totale}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ===================== -->
    <!-- SUMMARY -->
    <!-- ===================== -->
    <summary>
        <band height="50">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="12" isItalic="true"/>
                </textElement>
                <text><![CDATA[Grazie per il tuo acquisto]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>